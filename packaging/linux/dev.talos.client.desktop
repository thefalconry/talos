[Desktop Entry]
Type=Application
Name=Talos
GenericName=AI agent client
Comment=Chat with your Talon agent from the desktop
Exec=talos %u
Icon=dev.talos.client
Terminal=false
Categories=Network;Chat;
MimeType=x-scheme-handler/talon;
StartupWMClass=talos
StartupNotify=true
